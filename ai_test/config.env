# Shared test configuration.
#
# Counts are for the checked-in capture.bin at the repository root. Update this
# file only when the capture or intentionally-tested parser behavior changes.
EXPECTED_TRANSACTIONS=5969
EXPECTED_SLOTS=66
EXPECTED_BLOCK_META=34
EXPECTED_ACCOUNTS=0
# Includes 38 additional swaps decoded by the CPMM and AMM v4 parsers.
EXPECTED_SWAPS=2471
EXPECTED_HOPS=211
EXPECTED_TRADES=255
EXPECTED_LAUNCHES=5
EXPECTED_LIQUIDITY=1
EXPECTED_POOLS=0

# Runtime guards. These are generous enough to avoid flaky failures while still
# catching hangs and catastrophic slowdowns.
AI_TEST_APP_TIMEOUT=180
AI_TEST_MAX_REPLAY_MS=60000
AI_TEST_MIN_UNIT_TESTS=24
